@* COMENTARIO EXPLICATIVO: Estructura compartida: Bootstrap, navegación por rol, identidad en Session, mensajes y recursos comunes. *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoU1</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoU1.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container">
                <a class="navbar-brand app-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-camera-reels-fill" aria-hidden="true"></i></span><span>Sakila<span class="brand-accent">Rent</span></span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    @* Los enlaces se muestran segun el rol guardado en Session; el filtro del servidor aplica la restriccion real. *@
                    <ul class="navbar-nav app-nav mx-lg-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Catalogo" asp-action="Index"><i class="bi bi-collection-play" aria-hidden="true"></i> Catálogo</a></li>
    @* Muestra este bloque solo cuando se cumple la condicion de estado o rol. *@
                        @if (Context.Session.GetString("Rol") == "Cliente")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Alquileres" asp-action="MisAlquileres"><i class="bi bi-film" aria-hidden="true"></i> Mis alquileres</a></li>
                        }
    @* Muestra este bloque solo cuando se cumple la condicion de estado o rol. *@
                        @if (Context.Session.GetString("Rol") == "Administrador")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Peliculas" asp-action="Index"><i class="bi bi-sliders" aria-hidden="true"></i> Administración</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-people" aria-hidden="true"></i> Cuentas</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reportes" asp-action="PeliculasMasAlquiladas"><i class="bi bi-bar-chart-line" aria-hidden="true"></i> Reportes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reportes" asp-action="Alquileres"><i class="bi bi-receipt" aria-hidden="true"></i> Alquileres</a></li>
                        }
                    </ul>
    @* Muestra este bloque solo cuando se cumple la condicion de estado o rol. *@
                    @if (Context.Session.GetString("NombreUsuario") is string nombreUsuario)
                    {
                        <div class="nav-user"><span class="user-avatar"><i class="bi bi-person-fill" aria-hidden="true"></i></span><span class="user-meta"><strong>@nombreUsuario</strong><small>@Context.Session.GetString("Rol")</small></span></div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="ms-lg-3 mt-3 mt-lg-0">
                            <button type="submit" class="btn btn-outline-dark btn-sm"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Salir</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-sm nav-login mt-3 mt-lg-0" asp-controller="Account" asp-action="Login"><i class="bi bi-person-circle" aria-hidden="true"></i> Ingresar</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-content">
        <main role="main" class="pb-5">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2">
            <span><i class="bi bi-camera-reels" aria-hidden="true"></i> SakilaRent · Sistema de renta de películas</span>
            <span>Proyecto académico ASP.NET Core MVC</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
