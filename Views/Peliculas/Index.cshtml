@* COMENTARIO EXPLICATIVO: Tabla administrativa de películas, inventario, estado y acciones CRUD o reactivacion. *@
@model IReadOnlyList<ProyectoU1.Models.Pelicula>
@{
    ViewData["Title"] = "Administrar películas";
}

<header class="page-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3">
    <div><div class="eyebrow"><i class="bi bi-sliders" aria-hidden="true"></i> Panel administrativo</div><h1>Películas</h1><p class="mb-0">Administra el catálogo, las copias y el estado de cada película.</p></div>
    <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Crear película</a>
</header>

<form method="get" class="catalog-search d-flex align-items-center">
    <i class="bi bi-search ms-3 text-secondary" aria-hidden="true"></i>
    <input name="q" value="@Context.Request.Query["q"]" class="form-control" placeholder="Buscar por título" aria-label="Buscar película" />
    <button class="btn btn-primary" type="submit">Buscar</button>
    @* Muestra este bloque solo cuando se cumple la condicion de estado o rol. *@
    @if (Context.Request.Query.ContainsKey("q")) { <a class="btn btn-light ms-2" asp-action="Index" aria-label="Limpiar búsqueda"><i class="bi bi-x-lg" aria-hidden="true"></i></a> }
</form>

<div class="table-shell table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Película</th><th>Copias</th><th>Disponibles</th><th>Estado</th><th>Acciones</th></tr></thead>
        <tbody>
    @* Recorre los datos preparados por el controlador para crear filas o tarjetas. *@
        @foreach (var film in Model)
        {
            <tr>
                <td><div class="d-flex align-items-center gap-2"><span class="movie-poster-icon" style="width:36px;height:36px;border-radius:11px;font-size:1rem"><i class="bi bi-film" aria-hidden="true"></i></span><strong>@film.Title</strong></div></td>
                <td>@film.TotalCopies</td>
                <td>@film.AvailableCopies</td>
                <td><span class="@(film.IsActive ? "availability-badge" : "soft-badge")">@if (film.IsActive) { <i class="bi bi-check-circle-fill" aria-hidden="true"></i> } else { <i class="bi bi-archive" aria-hidden="true"></i> } @(film.IsActive ? "Activa" : "Desactivada")</span></td>
                <td><div class="action-group">
    @* Muestra este bloque solo cuando se cumple la condicion de estado o rol. *@
                    @if (film.IsActive)
                    {
                        <a asp-controller="Peliculas" asp-action="Editar" asp-route-id="@film.FilmId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Editar</a>
                        <a asp-controller="Peliculas" asp-action="Inventario" asp-route-id="@film.FilmId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-seam me-1" aria-hidden="true"></i>Inventario</a>
                        <form asp-controller="Peliculas" asp-action="Desactivar" asp-route-id="@film.FilmId" method="post" onsubmit="return confirm('¿Desactivar esta película?');"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-archive me-1" aria-hidden="true"></i>Desactivar</button></form>
                    }
                    else
                    {
                        <form asp-controller="Peliculas" asp-action="Reactivar" asp-route-id="@film.FilmId" method="post" onsubmit="return confirm('¿Reactivar esta película?');"><button class="btn btn-sm btn-outline-success"><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Reactivar</button></form>
                    }
                </div></td>
            </tr>
        }
        </tbody>
    </table>
</div>
    @* Muestra este bloque solo cuando se cumple la condicion de estado o rol. *@
@if (Model.Count == 0) { <div class="empty-state"><i class="bi bi-film" aria-hidden="true"></i><h2 class="h5">No hay películas para mostrar</h2><p>Crea una película o cambia el texto de búsqueda.</p></div> }
